pipeline {
  agent any
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Validate Python') { steps { sh 'python3 -m py_compile 06-grafana-monitoring/delivery_metrics.py' } }
    stage('Build') { steps { dir('06-grafana-monitoring') { sh 'docker compose build' } } }
    stage('Deploy') { steps { dir('06-grafana-monitoring') { sh 'docker compose up -d' } } }
    stage('Check Metrics') { steps { sh 'curl --fail --retry 10 --retry-delay 2 http://localhost:8000/metrics' } }
  }
}
